# ══════════════════════════════════════════════════════════════
# Senlis Participatif — Variables d'environnement API
# Copier ce fichier en .env et compléter les valeurs.
# ⚠️ Ne JAMAIS commiter le .env (il est dans .gitignore)
# ══════════════════════════════════════════════════════════════

# ── Base de données ──────────────────────────────────────────
DATABASE_URL=postgresql://senlis:senlis_dev_password@localhost:5432/senlis_participatif

# ── Serveur ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Client (CORS + liens dans les emails) ────────────────────
CLIENT_URL=http://localhost:5173

# ── Auth ─────────────────────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REMPLACER_PAR_64_CARACTERES_ALEATOIRES
JWT_EXPIRES_IN=7h

# ── Email (Mailtrap en dev, Brevo en prod) ───────────────────
# DEV — Mailtrap (boîte de test, rien ne part vers de vrais destinataires) :
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=votre_user_mailtrap
SMTP_PASS=votre_pass_mailtrap
EMAIL_FROM=Senlis Participatif <no-reply@senlis-participatif.fr>
#
# PRODUCTION — Brevo (S5-10) : remplacer les 3 lignes SMTP_* ci-dessus par
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=<login SMTP Brevo, visible dans Brevo > Paramètres SMTP & API>
# SMTP_PASS=<clé SMTP Brevo — PAS le mot de passe du compte>
# ⚠️ Penser à configurer les enregistrements DNS SPF/DKIM fournis par Brevo
#    sur le domaine d'envoi (Brevo > Expéditeurs & IP > Domaines).
# ⚠️ CNIL (recommandation du 14/04/2026, pixels de suivi) : désactiver le
#    suivi d'ouverture dans Brevo > Paramètres > Suivi des emails — nos
#    emails sont transactionnels, pas du marketing, pas besoin de savoir
#    qui les a ouverts. Réglage à faire dans le tableau de bord Brevo,
#    ce n'est pas quelque chose que le code peut activer/désactiver.

# ── Jetons email ─────────────────────────────────────────────
TOKEN_TTL_MINUTES=60

# ── email ADMIN ─────────────────────────────────────────────
ADMIN_EMAIL=mairie@senlis.fr
ADMIN_PASSWORD="..."
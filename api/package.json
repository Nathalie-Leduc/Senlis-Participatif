{
  "name": "senlis-participatif-api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST — Senlis Participatif",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "postinstall": "prisma generate",
    "seed": "node --env-file-if-exists=.env prisma/seed.js",
    "seed:prod": "node --env-file-if-exists=.env prisma/seed-prod.js",
    "seed:demo": "node --env-file-if-exists=.env prisma/seed-demo.js",
    "purge": "node --env-file-if-exists=.env scripts/purge.js",
    "secrets": "node scripts/generate-secrets.js",
    "migrate:test": "dotenv-cli -e .env.test -- npx prisma migrate deploy",
    "migrate:deploy": "prisma migrate deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.2",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "sharp": "^0.35.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dotenv-cli": "^11.1.0",
    "eslint": "^10.15.0",
    "supertest": "^7.3.2",
    "vitest": "^5.1.1"
  }
}
